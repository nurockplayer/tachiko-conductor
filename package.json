{
  "name": "tachiko-conductor",
  "version": "0.1.0",
  "description": "Local orchestration core and deterministic workflow state machine for Tachiko Conductor.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tachiko": "dist/cli.js"
  },
  "scripts": {
    "browser:install": "playwright install chromium",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node scripts/run-test-tier.mjs unit",
    "test:integration": "node scripts/run-test-tier.mjs integration",
    "test:smoke:claude": "node scripts/run-test-tier.mjs smoke:claude",
    "test:smoke:codex": "node scripts/run-test-tier.mjs smoke:codex",
    "test:smoke:worker-router": "node scripts/run-test-tier.mjs smoke:worker-router",
    "test:smoke:browser-agent": "node scripts/run-test-tier.mjs smoke:browser-agent"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.63.0-alpha-2026-08-05",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.79"
  }
}
