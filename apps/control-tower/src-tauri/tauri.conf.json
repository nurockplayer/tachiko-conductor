{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachiko Control Tower",
  "version": "0.1.0",
  "identifier": "com.nurockplayer.tachiko-control-tower",
  "build": {
    "beforeDevCommand": "corepack pnpm@10.34.5 run dev",
    "beforeBuildCommand": "corepack pnpm@10.34.5 run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Tachiko Control Tower", "width": 1100, "height": 760, "minWidth": 320, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "11.0" } }
}
